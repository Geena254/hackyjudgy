# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key_here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_PROJECT_ID=your-project-ref

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# SendGrid SMTP Configuration (for custom/test email scripts)
# SMTP_USER is always 'apikey' for SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.your_sendgrid_api_key_here
SMTP_FROM=noreply@powerlearnprojectafrica.org

# Anthropic API (server only, used for AI grading of entries)
ANTHROPIC_API_KEY=sk-ant-your_api_key_here

# Optional: GitHub token (no scopes needed) so AI grading can read repo file lists
# past GitHub's 60 requests an hour limit for anonymous requests
GITHUB_TOKEN=
